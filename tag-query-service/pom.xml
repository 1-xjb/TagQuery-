<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================ -->
    <!-- Spring Boot 2.x Parent (JDK 11 兼容)                          -->
    <!-- ============================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.platform</groupId>
    <artifactId>tag-query-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>实时标签查询服务</name>
    <description>统一实时标签查询后端服务</description>

    <properties>
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
        关闭增量编译。项目路径含不可见字符（TagQuery 目录名末尾的零宽空格 U+200B），
        在 GBK 默认编码下无法写入编译状态文件，导致 "Error while storing the mojo status: Input length = 1"。
        根治方案：重命名目录去掉零宽空格后可恢复增量编译。
        -->
        <maven.compiler.useIncrementalCompilation>false</maven.compiler.useIncrementalCompilation>

        <!-- 依赖版本集中管理 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <xxl-job.version>3.4.2</xxl-job.version>
        <aws.sdk.version>2.27.21</aws.sdk.version>
        <apollo.version>1.9.0</apollo.version>
    </properties>

    <!-- ============================================================ -->
    <!-- BOM：统一管理多模块版本                                      -->
    <!-- ============================================================ -->
    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK v2 版本清单（所有 software.amazon.awssdk 模块统一版本） -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ========================================================= -->
        <!-- Spring Boot 基础框架                                      -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- 数据层：MyBatis-Plus + MySQL                              -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================================================= -->
        <!-- Flyway 数据库版本迁移                                      -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- Redis 缓存 & 限流                                          -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- 配置中心：Apollo（目前注释掉，因没有服务端会影响启动）       -->
        <!-- ========================================================= -->
        <!--
        注意：Apollo 配置中心客户端。
        当前服务端未就绪，若取消注释会在启动时尝试连接 Apollo，
        连不上会导致应用启动失败。
        待 Apollo 服务端部署完成后，取消下方注释即可启用。
        -->
        <!--
        <dependency>
            <groupId>com.ctrip.framework.apollo</groupId>
            <artifactId>apollo-client-config-data</artifactId>
            <version>${apollo.version}</version>
        </dependency>
        -->

        <!-- ========================================================= -->
        <!-- XXL-Job 分布式调度（纯 jar，不加配置类就不初始化，          -->
        <!-- 不影响启动）                                              -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>${xxl-job.version}</version>
        </dependency>

        <!-- ========================================================= -->
        <!-- AWS S3 SDK（纯 jar，不写代码就不初始化，不影响启动）        -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- 邮件通知                                                  -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- Thymeleaf 模板引擎（邮件模板渲染）                         -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- 监控：Actuator + Prometheus                               -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- 工具类                                                    -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========================================================= -->
        <!-- 测试                                                      -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>tag-query-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
